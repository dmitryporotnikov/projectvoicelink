# ProjectVoiceLink Environment Configuration Template
# Copy this file to .env and fill in your values

# Telegram Bot API Token (from @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# Persistent Storage Paths (mapped inside container to ./data on host)
DATABASE_PATH=/app/data/ProjectVoiceLink.db
AUDIO_STORAGE_PATH=/app/data/audio_bottles

# Voice Duration Boundaries (in seconds)
MIN_VOICE_LENGTH_SECONDS=1
MAX_VOICE_LENGTH_SECONDS=180

# Anti-Spam & Rate-Limiting Cooldowns (in seconds)
VOICE_COOLDOWN_SECONDS=10
COMMAND_COOLDOWN_SECONDS=2

# Maintenance & Retention (in days / hours)
RETENTION_DAYS=30
MAINTENANCE_INTERVAL_HOURS=24

# Authorized Administrators (comma-separated numeric Telegram User IDs for /stats and /purge)
ADMIN_USER_IDS=

# Banned Users (comma-separated numeric Telegram User IDs)
BANNED_USER_IDS=
